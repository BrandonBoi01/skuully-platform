generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  country   String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  branches  Branch[]
  members   OrganizationMember[]
  schools   School[]
}

model Branch {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  members        BranchMember[]
  schools        School[]

  @@unique([organizationId, name], name: "unique_org_branch_name")
  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], name: "unique_org_member")
  @@index([organizationId])
  @@index([userId])
}

model BranchMember {
  id        String     @id @default(cuid())
  branchId  String
  userId    String
  role      BranchRole
  createdAt DateTime   @default(now())
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId], name: "unique_branch_member")
  @@index([branchId])
  @@index([userId])
}

model User {
  id                     String               @id @default(cuid())
  fullName               String
  email                  String               @unique
  phone                  String?              @unique
  passwordHash           String
  skuullyId              String               @unique
  avatarUrl              String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  attendanceMarks        AttendanceMark[]
  attendanceSessions     AttendanceSession[]
  branchMemberships      BranchMember[]
  dailyAttendancesLocked DailyAttendance[]    @relation("DailyAttendanceLockedBy")
  devicesCreated         Device[]             @relation("DeviceCreatedBy")
  excuseRequestsMade     ExcuseRequest[]      @relation("ExcuseRequestedBy")
  excuseRequestsReviewed ExcuseRequest[]      @relation("ExcuseReviewedBy")
  leaveOutsApproved      LeaveOutPass[]       @relation("LeaveOutApprovedBy")
  leaveOutsRequested     LeaveOutPass[]       @relation("LeaveOutRequestedBy")
  orgMemberships         OrganizationMember[]
  memberships            SchoolMembership[]
  staffProfiles          Staff[]              @relation("StaffUser")
  staffSessionMarks      StaffSessionMark[]   @relation("StaffSessionMarkedBy")
  visitorLogsCreated     VisitorLog[]         @relation("VisitorLogCreatedBy")
  emailVerifiedAt        DateTime?
  emailVerificationCodes EmailVerificationCode[]
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model School {
  id                 String              @id @default(cuid())
  name               String
  country            String              @default("Kenya")
  county             String?
  curriculum         String?
  logoUrl            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branchId           String?
  organizationId     String?
  attendanceEvents   AttendanceEvent[]
  attendanceSessions AttendanceSession[]
  dailyAttendances   DailyAttendance[]
  devices            Device[]
  excuseRequests     ExcuseRequest[]
  leaveOutPasses     LeaveOutPass[]
  branch             Branch?             @relation(fields: [branchId], references: [id])
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  invites            SchoolInvite[]
  members            SchoolMembership[]
  programs           SchoolProgram[]
  staff              Staff[]
  students           Student[]
  visitors           Visitor[]
  visitorLogs        VisitorLog[]

  @@index([organizationId])
  @@index([branchId])
}

model SchoolMembership {
  id        String     @id @default(cuid())
  schoolId  String
  userId    String
  role      SchoolRole
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())
  school    School     @relation(fields: [schoolId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@unique([userId, schoolId], name: "userId_schoolId")
  @@index([schoolId])
  @@index([userId])
}

model SchoolInvite {
  id        String     @id @default(cuid())
  schoolId  String
  email     String
  role      SchoolRole
  code      String     @unique
  status    String     @default("PENDING")
  createdAt DateTime   @default(now())
  expiresAt DateTime
  school    School     @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([email])
}

model CurriculumTemplate {
  id            String                      @id @default(cuid())
  name          String
  code          String                      @unique
  description   String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  grades        CurriculumTemplateGrade[]
  subjects      CurriculumTemplateSubject[]
  programs      SchoolProgram[]
  studentFields TemplateStudentField[]
}

model CurriculumTemplateGrade {
  id         String                           @id @default(cuid())
  templateId String
  name       String
  order      Int
  stage      String?
  template   CurriculumTemplate               @relation(fields: [templateId], references: [id])
  subjects   CurriculumTemplateGradeSubject[]

  @@unique([templateId, order])
  @@index([templateId])
}

model CurriculumTemplateSubject {
  id         String                           @id @default(cuid())
  templateId String
  name       String
  code       String?
  isCore     Boolean                          @default(true)
  grades     CurriculumTemplateGradeSubject[]
  template   CurriculumTemplate               @relation(fields: [templateId], references: [id])

  @@unique([templateId, name])
  @@index([templateId])
}

model CurriculumTemplateGradeSubject {
  id        String                    @id @default(cuid())
  gradeId   String
  subjectId String
  grade     CurriculumTemplateGrade   @relation(fields: [gradeId], references: [id])
  subject   CurriculumTemplateSubject @relation(fields: [subjectId], references: [id])

  @@unique([gradeId, subjectId])
  @@index([gradeId])
  @@index([subjectId])
}

model SchoolProgram {
  id                 String              @id @default(cuid())
  schoolId           String
  templateId         String
  name               String
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendanceSessions AttendanceSession[]
  excuseRequests     ExcuseRequest[]
  leaveOutPasses     LeaveOutPass[]
  classes            ProgramClass[]
  grades             ProgramGrade[]
  subjects           ProgramSubject[]
  school             School              @relation(fields: [schoolId], references: [id])
  template           CurriculumTemplate  @relation(fields: [templateId], references: [id])
  staff              Staff[]
  students           Student[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([templateId])
}

model ProgramGrade {
  id              String                @id @default(cuid())
  programId       String
  templateGradeId String?
  name            String
  order           Int
  stage           String?
  classes         ProgramClass[]
  program         SchoolProgram         @relation(fields: [programId], references: [id])
  subjects        ProgramGradeSubject[]

  @@unique([programId, order])
  @@index([programId])
}

model ProgramClass {
  id                 String              @id @default(cuid())
  programId          String
  gradeId            String
  name               String
  createdAt          DateTime            @default(now())
  attendanceSessions AttendanceSession[]
  grade              ProgramGrade        @relation(fields: [gradeId], references: [id])
  program            SchoolProgram       @relation(fields: [programId], references: [id])
  students           Student[]

  @@unique([programId, name])
  @@index([programId])
  @@index([gradeId])
}

model ProgramSubject {
  id                String                @id @default(cuid())
  programId         String
  templateSubjectId String?
  name              String
  code              String?
  isCore            Boolean               @default(true)
  grades            ProgramGradeSubject[]
  program           SchoolProgram         @relation(fields: [programId], references: [id])

  @@unique([programId, name])
  @@index([programId])
}

model ProgramGradeSubject {
  id        String         @id @default(cuid())
  gradeId   String
  subjectId String
  grade     ProgramGrade   @relation(fields: [gradeId], references: [id])
  subject   ProgramSubject @relation(fields: [subjectId], references: [id])

  @@unique([gradeId, subjectId])
  @@index([gradeId])
  @@index([subjectId])
}

model Student {
  id              String              @id @default(cuid())
  schoolId        String
  programId       String
  classId         String?
  admissionNo     String?
  fullName        String
  gender          String?
  dob             DateTime?
  status          String              @default("ACTIVE")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  attendanceMarks AttendanceMark[]
  excuseRequests  ExcuseRequest[]
  leaveOutPasses  LeaveOutPass[]
  class           ProgramClass?       @relation(fields: [classId], references: [id])
  program         SchoolProgram       @relation(fields: [programId], references: [id])
  school          School              @relation(fields: [schoolId], references: [id])
  fields          StudentFieldValue[]

  @@unique([schoolId, admissionNo], name: "schoolId_admissionNo")
  @@index([schoolId])
  @@index([programId])
  @@index([classId])
}

model TemplateStudentField {
  id                 String              @id @default(cuid())
  templateId         String
  key                String
  label              String
  type               String              @default("STRING")
  required           Boolean             @default(false)
  uniqueScope        String?
  optionsJson        String?
  createdAt          DateTime            @default(now())
  studentFieldValues StudentFieldValue[]
  template           CurriculumTemplate  @relation(fields: [templateId], references: [id])

  @@unique([templateId, key])
  @@index([templateId])
}

model StudentFieldValue {
  id        String               @id @default(cuid())
  studentId String
  fieldId   String
  value     String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  field     TemplateStudentField @relation(fields: [fieldId], references: [id])
  student   Student              @relation(fields: [studentId], references: [id])

  @@unique([studentId, fieldId])
  @@index([studentId])
  @@index([fieldId])
}

model Staff {
  id             String             @id @default(cuid())
  schoolId       String
  programId      String?
  userId         String?
  fullName       String
  phone          String?
  email          String?
  staffNo        String?
  staffType      StaffType          @default(NON_TEACHING)
  engagement     StaffEngagement    @default(FULL_TIME)
  attendanceMode AttendanceMode     @default(DAILY)
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  program        SchoolProgram?     @relation(fields: [programId], references: [id])
  school         School             @relation(fields: [schoolId], references: [id])
  user           User?              @relation("StaffUser", fields: [userId], references: [id])
  sessionMarks   StaffSessionMark[]

  @@unique([schoolId, staffNo], name: "unique_school_staffNo")
  @@index([schoolId])
  @@index([programId])
  @@index([userId])
  @@index([status])
}

model AttendanceSession {
  id          String                  @id @default(cuid())
  schoolId    String
  programId   String
  classId     String
  date        DateTime
  periodName  String?
  status      AttendanceSessionStatus @default(OPEN)
  createdById String
  createdAt   DateTime                @default(now())
  closedAt    DateTime?
  sessionType AttendanceSessionType   @default(CLASS_ROLLCALL)
  marks       AttendanceMark[]
  class       ProgramClass            @relation(fields: [classId], references: [id])
  createdBy   User                    @relation(fields: [createdById], references: [id])
  program     SchoolProgram           @relation(fields: [programId], references: [id])
  school      School                  @relation(fields: [schoolId], references: [id])
  staffMarks  StaffSessionMark[]

  @@unique([classId, date, periodName], name: "unique_class_day_period")
  @@index([schoolId, programId, classId, date])
  @@index([sessionType])
}

model AttendanceMark {
  id         String            @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus
  note       String?
  markedById String
  markedAt   DateTime          @default(now())
  markedBy   User              @relation(fields: [markedById], references: [id])
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId], name: "unique_mark_per_session_student")
  @@index([studentId])
  @@index([sessionId])
}

model StaffSessionMark {
  id         String            @id @default(cuid())
  sessionId  String
  staffId    String
  status     AttendanceStatus
  note       String?
  markedById String?
  markedAt   DateTime          @default(now())
  markedBy   User?             @relation("StaffSessionMarkedBy", fields: [markedById], references: [id])
  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff      Staff             @relation(fields: [staffId], references: [id])

  @@unique([sessionId, staffId], name: "unique_staff_mark_per_session")
  @@index([sessionId])
  @@index([staffId])
}

model AttendanceEvent {
  id         String               @id @default(cuid())
  schoolId   String
  programId  String?
  personType AttendancePersonType
  personId   String
  eventType  AttendanceEventType
  source     AttendanceSource
  occurredAt DateTime
  metaJson   Json?
  createdAt  DateTime             @default(now())
  deviceId   String?
  device     Device?              @relation(fields: [deviceId], references: [id])
  school     School               @relation(fields: [schoolId], references: [id])

  @@index([schoolId, occurredAt])
  @@index([personType, personId, occurredAt])
  @@index([deviceId])
}

model DailyAttendance {
  id                       String                      @id @default(cuid())
  schoolId                 String
  programId                String?
  personType               AttendancePersonType
  personId                 String
  date                     DateTime
  status                   AttendanceStatus
  firstIn                  DateTime?
  lastOut                  DateTime?
  minutesOnSite            Int                         @default(0)
  computedFrom             DailyAttendanceComputedFrom @default(MANUAL)
  updatedAt                DateTime                    @updatedAt
  createdAt                DateTime                    @default(now())
  declaredCount            Int                         @default(0)
  isLocked                 Boolean                     @default(false)
  lastDeclaredAt           DateTime?
  lastDeclaredByUserId     String?
  lockedAt                 DateTime?
  lockedByRole             SchoolRole?
  lockedByUserId           String?
  lockedSource             AttendanceSource?
  lastManualEditedAt       DateTime?
  lastManualEditedByUserId String?
  lastUndeclaredAt         DateTime?
  lastUndeclaredByUserId   String?
  manualEditCount          Int                         @default(0)
  undeclaredCount          Int                         @default(0)
  lockedBy                 User?                       @relation("DailyAttendanceLockedBy", fields: [lockedByUserId], references: [id])
  school                   School                      @relation(fields: [schoolId], references: [id])
  changes                  DailyAttendanceChange[]

  @@unique([personType, personId, date], name: "unique_daily_person_date")
  @@index([schoolId, date])
  @@index([programId, date])
}

model DailyAttendanceChange {
  id                String                    @id @default(cuid())
  dailyAttendanceId String
  schoolId          String
  programId         String?
  personType        AttendancePersonType
  personId          String
  date              DateTime
  fromStatus        AttendanceStatus?
  toStatus          AttendanceStatus
  changeType        DailyAttendanceChangeType @default(STATUS)
  changedByUserId   String?
  changedByRole     SchoolRole?
  source            AttendanceSource
  reason            String?
  createdAt         DateTime                  @default(now())
  dailyAttendance   DailyAttendance           @relation(fields: [dailyAttendanceId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@index([personType, personId, date])
  @@index([dailyAttendanceId])
}

model ExcuseRequest {
  id                String         @id @default(cuid())
  schoolId          String
  programId         String?
  studentId         String
  dateFrom          DateTime
  dateTo            DateTime
  reason            String?
  status            ApprovalStatus @default(PENDING)
  requestedByUserId String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  metaJson          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  program           SchoolProgram? @relation(fields: [programId], references: [id])
  requestedBy       User?          @relation("ExcuseRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy        User?          @relation("ExcuseReviewedBy", fields: [reviewedByUserId], references: [id])
  school            School         @relation(fields: [schoolId], references: [id])
  student           Student        @relation(fields: [studentId], references: [id])

  @@index([schoolId, studentId, dateFrom])
  @@index([programId, status])
  @@index([status])
}

model LeaveOutPass {
  id                String         @id @default(cuid())
  schoolId          String
  programId         String?
  studentId         String
  reason            String?
  status            ApprovalStatus @default(PENDING)
  grantedAt         DateTime?
  expectedReturnAt  DateTime?
  returnedAt        DateTime?
  requestedByUserId String?
  approvedByUserId  String?
  metaJson          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  approvedBy        User?          @relation("LeaveOutApprovedBy", fields: [approvedByUserId], references: [id])
  program           SchoolProgram? @relation(fields: [programId], references: [id])
  requestedBy       User?          @relation("LeaveOutRequestedBy", fields: [requestedByUserId], references: [id])
  school            School         @relation(fields: [schoolId], references: [id])
  student           Student        @relation(fields: [studentId], references: [id])

  @@index([schoolId, studentId])
  @@index([programId, status])
  @@index([status])
}

model Device {
  id              String            @id @default(cuid())
  schoolId        String
  name            String
  type            String
  status          String            @default("ACTIVE")
  apiKeyHash      String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  events          AttendanceEvent[]
  createdBy       User?             @relation("DeviceCreatedBy", fields: [createdByUserId], references: [id])
  school          School            @relation(fields: [schoolId], references: [id])
  visitorLogs     VisitorLog[]

  @@index([schoolId])
  @@index([status])
}

model Visitor {
  id        String       @id @default(cuid())
  schoolId  String
  fullName  String
  idType    String?
  idNumber  String?
  phone     String?
  company   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  school    School       @relation(fields: [schoolId], references: [id])
  logs      VisitorLog[]

  @@index([schoolId])
  @@index([idNumber])
}

model VisitorLog {
  id              String    @id @default(cuid())
  schoolId        String
  visitorId       String
  purpose         String?
  checkedInAt     DateTime  @default(now())
  checkedOutAt    DateTime?
  createdByUserId String?
  deviceId        String?
  metaJson        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       User?     @relation("VisitorLogCreatedBy", fields: [createdByUserId], references: [id])
  device          Device?   @relation(fields: [deviceId], references: [id])
  school          School    @relation(fields: [schoolId], references: [id])
  visitor         Visitor   @relation(fields: [visitorId], references: [id])

  @@index([schoolId, checkedInAt])
  @@index([visitorId])
  @@index([deviceId])
}

enum SchoolRole {
  OWNER
  ADMIN
  TEACHER
  ACCOUNTANT
  HR
}

enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_VIEWER
}

enum BranchRole {
  BRANCH_ADMIN
  BRANCH_VIEWER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum AttendancePersonType {
  STUDENT
  STAFF
  VISITOR
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  IN_CLASS
  OUT_CLASS
  BOARD_BUS
  ALIGHT_BUS
  EXCUSE_REQUESTED
  EXCUSE_APPROVED
  EXCUSE_REJECTED
  EXCUSE_CANCELLED
  LEAVE_OUT_REQUESTED
  LEAVE_OUT_GRANTED
  LEAVE_OUT_REJECTED
  LEAVE_OUT_RETURNED
  LEAVE_OUT_CANCELLED
  VISITOR_CHECK_IN
  VISITOR_CHECK_OUT
}

enum AttendanceSource {
  MANUAL
  TEACHER_ROLLCALL
  QR
  GATE_SCANNER
  GEOFENCE
  WATCH
  BUS
  PARENT_APP
  STUDENT_APP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StaffType {
  TEACHING
  NON_TEACHING
}

enum StaffEngagement {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  VISITING
}

enum AttendanceMode {
  DAILY
  SESSION
}

enum AttendanceSessionType {
  CLASS_ROLLCALL
  LESSON
  STAFF_SESSION
}

enum DailyAttendanceComputedFrom {
  MANUAL
  EVENTS
  MIXED
}

enum DailyAttendanceChangeType {
  STATUS
  LOCK
  UNLOCK
  TIMES
  SYSTEM
}
