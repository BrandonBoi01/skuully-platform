generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                      @id @default(cuid())
  skuullyId                      String                      @unique
  fullName                       String
  firstName                      String?
  lastName                       String?
  email                          String?                     @unique
  phone                          String?                     @unique
  passwordHash                   String?
  avatarUrl                      String?
  coverImageUrl                  String?
  bio                            String?
  headline                       String?
  pronoun                        Pronoun?
  gender                         String?
  dateOfBirth                    DateTime?
  isMinor                        Boolean                     @default(false)
  nationalityCode                String?
  residenceCountryCode           String?
  residenceSubdivisionId         String?
  residenceCityId                String?
  addressLine1                   String?
  addressLine2                   String?
  timezone                       String?
  languageCode                   String?
  profileVisibility              ProfileVisibility           @default(PRIVATE)
  accountStatus                  AccountStatus               @default(ACTIVE)
  trustLevel                     TrustLevel                  @default(LOW)
  emailVerifiedAt                DateTime?
  phoneVerifiedAt                DateTime?
  onboardingCompletedAt          DateTime?
  preferredLoginMethod           LoginMethod?
  lastActiveAt                   DateTime?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  authAuditLogs                  AuthAuditLog[]
  authProviderAccounts           AuthProviderAccount[]
  badgesIssued                   BadgeAward[]                @relation("BadgeAwardedByUser")
  badgesReceived                 BadgeAward[]                @relation("BadgeAwardedToUser")
  certificatesIssued             Credential[]                @relation("CredentialIssuedByUser")
  credentialsReceived            Credential[]                @relation("CredentialRecipientUser")
  receivedMessages               DirectMessage[]             @relation("DirectMessageReceiver")
  sentMessages                   DirectMessage[]             @relation("DirectMessageSender")
  emailVerificationCodes         EmailVerificationCode[]
  hopeApplicationsCreated        HopeApplication[]           @relation("HopeApplicantUser")
  hopeApplicationsReviewed       HopeApplication[]           @relation("HopeReviewedBy")
  hopeDonations                  HopeDonation[]              @relation("HopeDonorUser")
  followingInstitutions          InstitutionFollow[]
  joinRequestsReviewed           InstitutionJoinRequest[]    @relation("InstitutionJoinRequestReviewedBy")
  joinRequestsCreated            InstitutionJoinRequest[]    @relation("InstitutionJoinRequestUser")
  memberships                    Membership[]
  invitedMemberships             MembershipInvite[]          @relation("MembershipInviteInvitedBy")
  moments                        Moment[]
  momentComments                 MomentComment[]
  momentStars                    MomentStar[]
  receivedNotifications          Notification[]
  passwordResetTokens            PasswordResetToken[]
  phoneVerificationCodes         PhoneVerificationCode[]
  refreshSessions                RefreshSession[]
  socialProfile                  SocialProfile?
  staffProfiles                  StaffProfile[]
  guardianLinks                  StudentGuardianLink[]       @relation("GuardianUser")
  childLinks                     StudentGuardianLink[]       @relation("StudentUser")
  studentPositionAssignmentsMade StudentPositionAssignment[] @relation("StudentPositionAssignedByUser")
  studentProfiles                StudentProfile[]
  createdTribes                  Tribe[]                     @relation("TribeCreatedByUser")
  tribeMemberships               TribeMember[]
  nationalityCountry             GeoCountry?                 @relation("UserNationalityCountry", fields: [nationalityCode], references: [code])
  residenceCity                  GeoCity?                    @relation(fields: [residenceCityId], references: [id])
  residenceCountry               GeoCountry?                 @relation("UserResidenceCountry", fields: [residenceCountryCode], references: [code])
  residenceSubdivision           GeoSubdivision?             @relation(fields: [residenceSubdivisionId], references: [id])
  followerUsers                  UserFollow[]                @relation("UserFollowFollowed")
  followingUsers                 UserFollow[]                @relation("UserFollowFollower")
  onboarding                     UserOnboarding?
  reviewedVerificationRequests   VerificationRequest[]       @relation("VerificationReviewedBy")
  verificationRequests           VerificationRequest[]
  studentEnrollmentsCreated      StudentEnrollment[]

  @@index([fullName])
  @@index([firstName])
  @@index([lastName])
  @@index([accountStatus])
  @@index([trustLevel])
  @@index([nationalityCode])
  @@index([residenceCountryCode])
}

model AuthProviderAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], name: "unique_provider_providerUserId")
  @@unique([userId, provider], name: "unique_user_provider")
  @@index([userId])
}

model EmailVerificationCode {
  id        String              @id @default(cuid())
  userId    String
  email     String
  code      String
  purpose   VerificationPurpose @default(EMAIL_VERIFY)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([purpose])
}

model PhoneVerificationCode {
  id        String              @id @default(cuid())
  userId    String
  phone     String
  code      String
  purpose   VerificationPurpose @default(PHONE_VERIFY)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([purpose])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  csrfTokenHash String
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  ipAddress     String?
  userAgent     String?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  phone     String?
  event     String
  success   Boolean  @default(false)
  reason    String?
  ipAddress String?
  userAgent String?
  metaJson  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

model GeoCountry {
  id                   String           @id @default(cuid())
  code                 String           @unique
  iso3                 String?          @unique
  name                 String
  officialName         String?
  flagEmoji            String?
  region               String?
  subregion            String?
  capital              String?
  currencyCode         String?
  currencyName         String?
  phoneCode            String?
  phoneMinLength       Int?
  phoneMaxLength       Int?
  nativeCurriculumName String?
  nativeCurriculumCode String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  cities               GeoCity[]
  subdivisions         GeoSubdivision[]
  timezones            GeoTimezone[]
  institutions         Institution[]    @relation("InstitutionCountry")
  nationalityUsers     User[]           @relation("UserNationalityCountry")
  residenceUsers       User[]           @relation("UserResidenceCountry")

  @@index([name])
  @@index([isActive])
}

model GeoSubdivision {
  id           String        @id @default(cuid())
  countryId    String
  code         String?
  name         String
  type         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cities       GeoCity[]
  country      GeoCountry    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  institutions Institution[]
  users        User[]

  @@unique([countryId, name])
  @@index([countryId])
}

model GeoCity {
  id            String          @id @default(cuid())
  countryId     String
  subdivisionId String?
  name          String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  country       GeoCountry      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  subdivision   GeoSubdivision? @relation(fields: [subdivisionId], references: [id])
  institutions  Institution[]
  users         User[]

  @@index([countryId])
  @@index([subdivisionId])
  @@index([name])
}

model GeoTimezone {
  id        String     @id @default(cuid())
  countryId String
  name      String
  utcOffset String?
  createdAt DateTime   @default(now())
  country   GeoCountry @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name])
  @@index([countryId])
}

model UserOnboarding {
  id                          String                 @id @default(cuid())
  userId                      String                 @unique
  route                       OnboardingRoute?
  accountIntent               AccountIntent?
  institutionTypeDraft        InstitutionType?
  institutionNameDraft        String?
  nationalityCodeDraft        String?
  residenceCountryCodeDraft   String?
  residenceSubdivisionIdDraft String?
  residenceCityIdDraft        String?
  addressLine1Draft           String?
  addressLine2Draft           String?
  pronounDraft                Pronoun?
  dateOfBirthDraft            DateTime?
  skuullyIdDraft              String?
  headlineDraft               String?
  avatarUrlDraft              String?
  academicLabelDraft          String?
  academicItemsDraft          String[]
  academicSetLater            Boolean                @default(false)
  learningModesDraft          LearningMode[]
  ownershipDraft              String?
  levelTypeDraft              String?
  genderAdmissionPolicyDraft  GenderAdmissionPolicy?
  phoneCountryCodeDraft       String?
  phoneDialCodeDraft          String?
  phoneNationalDraft          String?
  phoneE164Draft              String?
  phoneSetLater               Boolean                @default(true)
  currentStep                 String?
  completedAt                 DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  user                        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([route])
  @@index([accountIntent])
  @@index([institutionTypeDraft])
}

model Institution {
  id                         String                         @id @default(cuid())
  name                       String
  slug                       String                         @unique
  institutionType            InstitutionType
  institutionCategory        InstitutionCategory            @default(SCHOOL)
  description                String?
  legalName                  String?
  registrationNumber         String?
  taxId                      String?
  email                      String?
  primaryPhone               String?
  websiteUrl                 String?
  logoUrl                    String?
  coverImageUrl              String?
  foundedYear                Int?
  countryCode                String?
  subdivisionId              String?
  cityId                     String?
  addressLine1               String?
  addressLine2               String?
  postalCode                 String?
  timezone                   String?
  ownership                  String?
  levelType                  String?
  genderAdmissionPolicy      GenderAdmissionPolicy?
  learningModes              LearningMode[]
  curriculumSummary          String?
  verificationStatus         VerificationStatus             @default(PENDING)
  verificationSubmittedAt    DateTime?
  verifiedAt                 DateTime?
  suspendedAt                DateTime?
  onboardingCompletedAt      DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  roleDefinitions            AccessRole[]
  announcements              Announcement[]
  badgeDefinitions           BadgeDefinition[]
  billingInvoices            BillingInvoice[]
  classes                    ClassRoom[]
  competitionsHosted         Competition[]
  competitionEntries         CompetitionEntry[]
  credentials                Credential[]
  departments                Department[]
  hopeBeneficiaries          HopeBeneficiary[]
  donationAllocations        HopeDonationAllocation[]
  city                       GeoCity?                       @relation(fields: [cityId], references: [id])
  country                    GeoCountry?                    @relation("InstitutionCountry", fields: [countryCode], references: [code])
  subdivision                GeoSubdivision?                @relation(fields: [subdivisionId], references: [id])
  academicFrameworks         InstitutionAcademicFramework[]
  events                     InstitutionEvent[]
  followers                  InstitutionFollow[]
  joinRequests               InstitutionJoinRequest[]
  memberships                Membership[]
  invites                    MembershipInvite[]
  moments                    Moment[]                       @relation("InstitutionMoments")
  programs                   Program[]
  socialProfile              SocialProfile?
  staffProfiles              StaffProfile[]
  guardians                  StudentGuardianLink[]
  studentPositionAssignments StudentPositionAssignment[]
  studentPositionDefinitions StudentPositionDefinition[]
  students                   StudentProfile[]
  subscription               Subscription?
  tribes                     Tribe[]
  verificationRequests       VerificationRequest[]
  studentEnrollments         StudentEnrollment[]
  academicPeriods            AcademicPeriod[]

  @@index([institutionType])
  @@index([institutionCategory])
  @@index([countryCode])
  @@index([verificationStatus])
  @@index([name])
}

model Membership {
  id              String                   @id @default(cuid())
  institutionId   String
  userId          String
  membershipType  MembershipType
  status          MembershipStatus         @default(PENDING)
  isPrimary       Boolean                  @default(false)
  joinedAt        DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  departmentLinks DepartmentMembership[]
  institution     Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRoles   MembershipAssignedRole[]
  staffProfile    StaffProfile?

  @@unique([institutionId, userId], name: "unique_institution_user_membership")
  @@index([institutionId])
  @@index([userId])
  @@index([membershipType])
  @@index([status])
}

model MembershipInvite {
  id              String         @id @default(cuid())
  institutionId   String
  email           String
  membershipType  MembershipType
  invitedByUserId String?
  code            String         @unique
  status          InviteStatus   @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime       @default(now())
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedBy       User?          @relation("MembershipInviteInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([institutionId])
  @@index([email])
  @@index([status])
}

model Department {
  id                         String                      @id @default(cuid())
  institutionId              String
  code                       String?
  name                       String
  description                String?
  type                       DepartmentType?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  roles                      AccessRole[]
  institution                Institution                 @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships                DepartmentMembership[]
  staffProfiles              StaffProfile[]
  studentPositionDefinitions StudentPositionDefinition[]

  @@unique([institutionId, name], name: "unique_department_name_per_institution")
  @@index([institutionId])
}

model DepartmentMembership {
  id           String     @id @default(cuid())
  departmentId String
  membershipId String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([departmentId, membershipId], name: "unique_department_membership")
  @@index([departmentId])
  @@index([membershipId])
}

model AccessRole {
  id            String                   @id @default(cuid())
  institutionId String
  departmentId  String?
  key           String
  name          String
  description   String?
  scope         RoleScope                @default(INSTITUTION)
  isSystem      Boolean                  @default(false)
  isAssignable  Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  department    Department?              @relation(fields: [departmentId], references: [id])
  institution   Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  permissions   AccessRolePermission[]
  assignments   MembershipAssignedRole[]

  @@unique([institutionId, key], name: "unique_role_key_per_institution")
  @@unique([institutionId, name], name: "unique_role_name_per_institution")
  @@index([institutionId])
  @@index([departmentId])
}

model AccessRolePermission {
  id         String     @id @default(cuid())
  roleId     String
  permission String
  createdAt  DateTime   @default(now())
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission], name: "unique_role_permission")
  @@index([roleId])
}

model MembershipAssignedRole {
  id           String     @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId], name: "unique_membership_role")
  @@index([membershipId])
  @@index([roleId])
}

model InstitutionJoinRequest {
  id               String                       @id @default(cuid())
  institutionId    String
  userId           String
  requestType      InstitutionJoinRequestType
  status           InstitutionJoinRequestStatus @default(PENDING)
  referenceNumber  String?
  admissionNo      String?
  staffNo          String?
  note             String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  institution      Institution                  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reviewedBy       User?                        @relation("InstitutionJoinRequestReviewedBy", fields: [reviewedByUserId], references: [id])
  user             User                         @relation("InstitutionJoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([userId])
  @@index([requestType])
  @@index([status])
}

model InstitutionAcademicFramework {
  id            String      @id @default(cuid())
  institutionId String
  label         String
  code          String?
  category      String?
  isPrimary     Boolean     @default(false)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, label], name: "unique_framework_label_per_institution")
  @@index([institutionId])
}

model CurriculumTemplate {
  id            String                      @id @default(cuid())
  code          String                      @unique
  name          String
  description   String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  grades        CurriculumTemplateGrade[]
  subjects      CurriculumTemplateSubject[]
  programs      Program[]
  studentFields TemplateStudentField[]
}

model CurriculumTemplateGrade {
  id         String                           @id @default(cuid())
  templateId String
  name       String
  order      Int
  stage      String?
  template   CurriculumTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subjects   CurriculumTemplateGradeSubject[]

  @@unique([templateId, order])
  @@index([templateId])
}

model CurriculumTemplateSubject {
  id         String                           @id @default(cuid())
  templateId String
  name       String
  code       String?
  isCore     Boolean                          @default(true)
  grades     CurriculumTemplateGradeSubject[]
  template   CurriculumTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
  @@index([templateId])
}

model CurriculumTemplateGradeSubject {
  id        String                    @id @default(cuid())
  gradeId   String
  subjectId String
  grade     CurriculumTemplateGrade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject   CurriculumTemplateSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([gradeId, subjectId])
  @@index([gradeId])
  @@index([subjectId])
}

model Program {
  id                         String                      @id @default(cuid())
  institutionId              String
  templateId                 String?
  name                       String
  code                       String?
  status                     ProgramStatus               @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  classes                    ClassRoom[]
  institution                Institution                 @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  template                   CurriculumTemplate?         @relation(fields: [templateId], references: [id])
  grades                     ProgramGrade[]
  subjects                   ProgramSubject[]
  staffProfiles              StaffProfile[]
  studentPositionDefinitions StudentPositionDefinition[]
  students                   StudentProfile[]
  enrollments                StudentEnrollment[]

  @@unique([institutionId, name], name: "unique_program_name_per_institution")
  @@index([institutionId])
}

model ProgramGrade {
  id              String                @id @default(cuid())
  programId       String
  templateGradeId String?
  name            String
  order           Int
  stage           String?
  classes         ClassRoom[]
  program         Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  subjects        ProgramGradeSubject[]
  enrollments     StudentEnrollment[]

  @@unique([programId, order])
  @@index([programId])
}

model ProgramSubject {
  id                String                @id @default(cuid())
  programId         String
  templateSubjectId String?
  name              String
  code              String?
  isCore            Boolean               @default(true)
  grades            ProgramGradeSubject[]
  program           Program               @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, name])
  @@index([programId])
}

model ProgramGradeSubject {
  id        String         @id @default(cuid())
  gradeId   String
  subjectId String
  grade     ProgramGrade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject   ProgramSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([gradeId, subjectId])
  @@index([gradeId])
  @@index([subjectId])
}

model ClassRoom {
  id                         String                      @id @default(cuid())
  institutionId              String
  programId                  String
  gradeId                    String?
  name                       String
  code                       String?
  capacity                   Int?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  grade                      ProgramGrade?               @relation(fields: [gradeId], references: [id])
  institution                Institution                 @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program                    Program                     @relation(fields: [programId], references: [id], onDelete: Cascade)
  studentPositionDefinitions StudentPositionDefinition[]
  students                   StudentProfile[]
  enrollments                StudentEnrollment[]

  @@unique([institutionId, name], name: "unique_class_name_per_institution")
  @@index([institutionId])
  @@index([programId])
  @@index([gradeId])
}

enum AcademicPeriodType {
  YEAR
  TERM
  SEMESTER
  QUARTER
  CUSTOM
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

model AcademicPeriod {
  id                String               @id @default(cuid())
  institutionId     String
  parentPeriodId    String?
  name              String
  code              String?
  type              AcademicPeriodType
  status            AcademicPeriodStatus @default(PLANNED)
  academicYearLabel String?
  termNumber        Int?
  startsAt          DateTime
  endsAt            DateTime
  isCurrent         Boolean              @default(false)
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  institution  Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentPeriod AcademicPeriod?  @relation("AcademicPeriodHierarchy", fields: [parentPeriodId], references: [id])
  childPeriods AcademicPeriod[] @relation("AcademicPeriodHierarchy")

  @@unique([institutionId, name], name: "unique_academic_period_name_per_institution")
  @@index([institutionId])
  @@index([parentPeriodId])
  @@index([type])
  @@index([status])
  @@index([isCurrent])
  @@index([academicYearLabel])
}

model TemplateStudentField {
  id          String              @id @default(cuid())
  templateId  String
  key         String
  label       String
  type        String              @default("STRING")
  required    Boolean             @default(false)
  uniqueScope String?
  optionsJson String?
  createdAt   DateTime            @default(now())
  values      StudentFieldValue[]
  template    CurriculumTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
}

model StudentProfile {
  id                  String                      @id @default(cuid())
  institutionId       String
  programId           String?
  classId             String?
  userId              String?
  admissionNo         String?
  fullName            String
  gender              String?
  dateOfBirth         DateTime?
  nationalityCode     String?
  status              StudentStatus               @default(ACTIVE)
  joinedAt            DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  competitionEntries  CompetitionEntry[]
  customFieldValues   StudentFieldValue[]
  guardians           StudentGuardianLink[]
  positionAssignments StudentPositionAssignment[]
  classRoom           ClassRoom?                  @relation(fields: [classId], references: [id])
  institution         Institution                 @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program             Program?                    @relation(fields: [programId], references: [id])
  user                User?                       @relation(fields: [userId], references: [id])

  enrollments StudentEnrollment[]

  @@unique([institutionId, admissionNo], name: "unique_admission_per_institution")
  @@unique([institutionId, userId], name: "unique_student_user_per_institution")
  @@index([institutionId])
  @@index([programId])
  @@index([classId])
  @@index([userId])
}

model StudentGuardianLink {
  id                String             @id @default(cuid())
  institutionId     String
  studentProfileId  String
  studentUserId     String?
  guardianUserId    String?
